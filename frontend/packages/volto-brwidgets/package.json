{
  "name": "@plonegovbr/volto-brwidgets",
  "version": "1.0.0-beta.1",
  "description": "Volto widgets for data used in Brazilian projects: CEP, CNPJ, CPF, states, and phone numbers.",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-widgets",
    "volto-addon",
    "volto",
    "brazil",
    "plone",
    "react"
  ],
  "author": "PloneGov-BR",
  "homepage": "https://github.com/plonegovbr/brfieldsandwidgets#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:plonegovbr/brfieldsandwidgets.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [],
  "theme": "",
  "dependencies": {
    "@brazilian-utils/brazilian-utils": "^2.5.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^3.12.1",
    "semantic-ui-react": "^2.1.5"
  },
  "devDependencies": {
    "@plone/registry": "workspace:*",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@storybook/react": "^8.0.4",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react-intl": "3.12.1",
    "release-it": "^19.0.5",
    "semantic-ui-react": "2.1.5",
    "typescript": "^5.7.3",
    "vitest": "^3.1.2"
  }
}
